# Copy to backend/.env and fill in. Never commit the real .env.
# With no API key at all the app runs in offline demo mode.

# groq (default) | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Anthropic instead: set LLM_PROVIDER=anthropic and LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Database (default: SQLite file at backend/data/tablewise.db). Postgres example:
# DATABASE_URL=postgresql+psycopg://tablewise:tablewise@localhost:5432/tablewise
