        "orientation": "auto"
      }
    },
    {
      "type": "barchart",
      "title": "Bookings by restaurant (next 7 days)",
      "id": 4,
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.name AS restaurant, count(b.id) AS bookings\nFROM restaurant r\nLEFT JOIN booking b ON b.restaurant_id = r.id\n  AND b.status = 'confirmed'\n  AND b.start_time >= current_date AND b.start_time < current_date + interval '7 days'\nGROUP BY r.name\nORDER BY bookings DESC, r.name"
        }
      ],
      "description": "Confirmed bookings per restaurant, today through the next 6 days.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "restaurant",
        "showValue": "always",
        "barWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "piechart",
      "title": "Bookings by source",
      "id": 5,
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(source, 'unknown') AS source, count(*) AS bookings\nFROM booking\nWHERE status = 'confirmed'\nGROUP BY 1\nORDER BY 2 DESC"
        }
      ],
      "description": "Where confirmed bookings came from: web, chat, mcp, google, phone.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Bookings over the next 7 days",
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(d, 'Dy DD Mon') AS day, count(b.id) AS bookings\nFROM generate_series(current_date, current_date + 6, interval '1 day') AS d\nLEFT JOIN booking b ON b.start_time::date = d::date AND b.status = 'confirmed'\nGROUP BY d\nORDER BY d"
        }
      ],
      "description": "Confirmed bookings per day, today plus six days (independent of the time picker).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "day",
        "showValue": "always",
        "barWidth": 0.6,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
