    {
      "type": "stat",
      "title": "Confirmed, next 7 days",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Next 7 days\"\nFROM booking\nWHERE status = 'confirmed'\n  AND start_time >= current_date AND start_time < current_date + interval '7 days'"
        }
      ],
      "description": "Confirmed bookings from today through the next 6 days.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "short",
          "decimals": 0
        },
